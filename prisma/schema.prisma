generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model globalchats_groups {
  id                          Int                           @id @default(autoincrement())
  owner_id                    BigInt
  name                        String                        @db.VarChar(64)
  description                 String                        @default("") @db.LongText
  cooltime                    Int                           @default(5)
  password                    String                        @default("") @db.VarChar(64)
  max_lines_count             Int                           @default(15)
  max_emotes_count            Int                           @default(10)
  minimum_guild_created_at    Int                           @default(0)
  minimum_user_created_at     Int                           @default(60)
  updated_at                  DateTime                      @db.DateTime(0)
  created_at                  DateTime                      @db.DateTime(0)
  globalchats_groups_channels globalchats_groups_channels[]
  globalchats_groups_ngwords  globalchats_groups_ngwords[]
  globalchats_messages        globalchats_messages[]
}

model globalchats_groups_channels {
  count              Int                @id @default(autoincrement())
  group_id           Int
  guild_id           BigInt
  channel_id         BigInt
  updated_at         DateTime           @db.DateTime(0)
  created_at         DateTime           @db.DateTime(0)
  globalchats_groups globalchats_groups @relation(fields: [group_id], references: [id], onUpdate: Restrict, map: "fk_globalchats_groups_channels_group_id__id")

  @@unique([group_id, guild_id, channel_id], map: "UNIQUE")
}

model globalchats_groups_ngwords {
  group_id           Int
  content            String             @db.VarChar(64)
  updated_at         DateTime           @db.DateTime(0)
  created_at         DateTime           @db.DateTime(0)
  globalchats_groups globalchats_groups @relation(fields: [group_id], references: [id], onUpdate: Restrict, map: "fk_globalchats_groups_ngwords_group_id__id")

  @@unique([group_id, content], map: "UNIQUE")
  @@index([group_id], map: "fk_globalchats_groups_ngwords_group_id__id")
}

model globalchats_messages {
  id                 String             @id @db.VarChar(10)
  group_id           Int
  guild_id           BigInt
  channel_id         BigInt
  user_id            BigInt
  message_id         BigInt
  is_api             Boolean            @default(false)
  message            String             @db.LongText
  destinations       String             @db.LongText
  updated_at         DateTime           @db.DateTime(0)
  created_at         DateTime           @db.DateTime(0)
  globalchats_groups globalchats_groups @relation(fields: [group_id], references: [id], onUpdate: Restrict, map: "fk_globalchats_messages_group_id__id")

  @@unique([group_id, guild_id, channel_id, user_id, message_id], map: "UNIQUE")
}

