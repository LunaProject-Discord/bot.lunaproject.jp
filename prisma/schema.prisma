generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model globalchats_groups {
  id                          Int                           @id @default(autoincrement())
  owner_id                    BigInt
  name                        String                        @db.VarChar(64)
  description                 String                        @default("") @db.Text
  cooltime                    Int                           @default(5)
  password                    String                        @default("") @db.VarChar(64)
  max_lines_count             Int                           @default(15)
  max_emotes_count            Int                           @default(10)
  minimum_guild_created_at    Int                           @default(0)
  minimum_user_created_at     Int                           @default(60)
  updated_at                  DateTime                      @db.DateTime(0)
  created_at                  DateTime                      @db.DateTime(0)
  globalchats_groups_channels globalchats_groups_channels[]
  globalchats_groups_ngwords  globalchats_groups_ngwords[]
  globalchats_messages        globalchats_messages[]
}

model globalchats_groups_channels {
  group_id           Int
  guild_id           BigInt
  channel_id         BigInt             @id
  updated_at         DateTime           @db.DateTime(0)
  created_at         DateTime           @db.DateTime(0)
  globalchats_groups globalchats_groups @relation(fields: [group_id], references: [id], onUpdate: Restrict, map: "fk_globalchats_groups_channels_group_id__id")

  @@unique([group_id, guild_id, channel_id], map: "UNIQUE")
}

model globalchats_groups_ngwords {
  group_id           Int
  content            String             @db.VarChar(64)
  updated_at         DateTime           @db.DateTime(0)
  created_at         DateTime           @db.DateTime(0)
  globalchats_groups globalchats_groups @relation(fields: [group_id], references: [id], onUpdate: Restrict, map: "fk_globalchats_groups_ngwords_group_id__id")

  @@unique([group_id, content], map: "UNIQUE")
}

model globalchats_messages {
  id                 String             @id @db.VarChar(10)
  group_id           Int
  guild_id           BigInt
  channel_id         BigInt
  user_id            BigInt
  message_id         BigInt
  is_api             Boolean            @default(false)
  message            String             @db.Text
  destinations       String             @db.Text
  updated_at         DateTime           @db.DateTime(0)
  created_at         DateTime           @db.DateTime(0)
  globalchats_groups globalchats_groups @relation(fields: [group_id], references: [id], onUpdate: Restrict, map: "fk_globalchats_messages_group_id__id")

  @@unique([group_id, guild_id, channel_id, user_id, message_id], map: "UNIQUE")
}

model guilds {
  id         BigInt   @id
  prefix     String   @default("s#") @db.VarChar(20)
  flags      String   @default("{\"verified\":false,\"partner\":false,\"tester\":false}") @db.Text
  prohibit   String   @default("{\"enabled\":false,\"type\":\"CUSTOM\",\"reason\":null,\"expired_at\":null}") @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model guilds_configurations {
  id             BigInt   @id
  prefix         String   @default("s#") @db.VarChar(32)
  nickname       String   @default("[%p] %n") @db.VarChar(32)
  language       String   @default("ja-JP") @db.VarChar(8)
  timezone       String   @default("Asia/Tokyo") @db.VarChar(32)
  commands       String   @default("{\"permissions\":{\"channels\":{\"default\":null,\"overrides\":{}},\"roles\":{\"default\":null,\"overrides\":{}},\"members\":{}},\"commands\":[]}") @db.Text
  welcome        String   @default("{\"enabled\":false,\"channel_id\":\"0\",\"message\":{\"content\":\"ようこそ！**{user:display_name}** さんが参加しました。\",\"embeds\":[]},\"roles\":[]}") @db.Text
  goodbye        String   @default("{\"enabled\":false,\"channel_id\":\"0\",\"message\":{\"content\":\"さようなら…。**{user:display_name}** さんが退出しました。\",\"embeds\":[]}}") @db.Text
  activity       String   @default("{\"enabled\":false,\"roles\":[]}") @db.Text
  global_chat    String   @default("{\"enabled\":true}") @db.Text
  global_ban     String   @default("{\"enabled\":false,\"minimum_evaluate_value\":4.0}") @db.Text
  level          String   @default("{\"enabled\":false,\"experience_per_message\":1,\"disabled\":{\"channels\":[],\"roles\":[]},\"reward\":{\"type\":\"STACK_PREVIOUS_ROLES\",\"remove_role_demoted\":false,\"roles\":[]},\"notification\":{\"type\":\"CURRENT_CHANNEL\",\"channel_id\":\"0\",\"message\":{\"content\":\"おめでとう！**{user:display_name}** さんがレベルアップしました！ ?\",\"embeds\":[{\"title\":\"レベル情報\",\"description\":\"\",\"url\":null,\"color\":\"#959ac0\",\"timestamp\":null,\"author\":null,\"fields\":[{\"name\":\"暫定順位\",\"value\":\"{rank:new}\",\"inline\":true},{\"name\":\"レベル\",\"value\":\"{level:new}\",\"inline\":true},{\"name\":\"経験値 (最大)\",\"value\":\"{xp:new} ({max_xp:new})\",\"inline\":true}],\"image\":null,\"footer\":null}]}},\"leaderboard\":{\"public\":false,\"allow_join\":false,\"vanity_code\":null}}") @db.Text
  translate      String   @default("{\"enabled\":true,\"reaction\":false,\"disabled\":{\"channels\":[],\"roles\":[]}}") @db.Text
  vote           String   @default("{\"enabled\":true,\"votes\":[]}") @db.Text
  quote          String   @default("{\"enabled\":false,\"reaction\":true,\"message\":false,\"other_guild_to_this_guild\":false,\"this_guild_to_other_guild\":false,\"disabled\":{\"channels\":[],\"roles\":[]}}") @db.Text
  music          String   @default("{\"enabled\":true,\"web_panel\":true,\"default_volume\":100,\"timeout_seconds\":180,\"next_media_notification\":true,\"sources\":{\"youtube\":true,\"niconico\":true,\"soundcloud\":true,\"twitch\":true,\"bandcamp\":true,\"vimeo\":true}}") @db.Text
  text_to_speech String   @default("{\"enabled\":false,\"dictionaries\":[],\"plan\":\"TIER_0\",\"remaining_standard_count\":10000,\"remaining_wavenet_count\":5000}") @db.Text
  logging        String   @default("{\"enabled\":false,\"moderation\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"update\":false,\"kick\":false,\"prune\":false,\"ban\":false,\"unban\":false},\"member\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"join\":false,\"leave\":false,\"update\":false,\"role_add\":false,\"role_remove\":false},\"voice\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"join\":false,\"leave\":false,\"move\":false,\"mute\":false,\"deafen\":false},\"category\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false,\"permissions_update\":false},\"text_channel\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false,\"permissions_update\":false},\"voice_channel\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false,\"permissions_update\":false},\"role\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false},\"emote\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false},\"invite\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false},\"webhook\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false},\"integration\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"create\":false,\"delete\":false,\"update\":false},\"message\":{\"enabled\":false,\"channel_id\":\"0\",\"color\":\"#959ac0\",\"update\":false,\"delete\":false,\"purge\":false,\"pin\":false,\"unpin\":false}}") @db.Text
  updated_at     DateTime @db.DateTime(0)
  created_at     DateTime @db.DateTime(0)
}

model guilds_dictionaries {
  count      Int      @id
  id         BigInt
  from       String   @db.Text
  to         String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model guilds_levels {
  count      Int      @id @default(autoincrement())
  guild_id   BigInt
  user_id    BigInt
  level      Int      @default(0)
  xp         Int      @default(0)
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)

  @@unique([guild_id, user_id], map: "UNIQUE")
  @@index([guild_id], map: "guild_id")
  @@index([user_id], map: "user_id")
}

model guilds_notifications {
  id                         Int                          @id @default(autoincrement())
  guild_id                   BigInt
  name                       String                       @db.VarChar(32)
  type                       guilds_notifications_type
  title                      String                       @db.VarChar(64)
  description                String                       @db.Text
  updated_at                 DateTime                     @db.DateTime(0)
  created_at                 DateTime                     @db.DateTime(0)
  guilds_notifications_reads guilds_notifications_reads[]

  @@unique([guild_id, name], map: "UNIQUE")
}

model guilds_notifications_reads {
  id                   Int
  guild_id             BigInt
  user_id              BigInt
  updated_at           DateTime             @db.DateTime(0)
  created_at           DateTime             @db.DateTime(0)
  guilds_notifications guilds_notifications @relation(fields: [id], references: [id], onUpdate: Restrict, map: "fk_guilds_notifications_reads_id__id")

  @@unique([id, guild_id, user_id], map: "UNIQUE")
}

model guilds_profiles {
  id         BigInt   @id
  name       String   @db.VarChar(100)
  icon_url   String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model guilds_punishments_bans {
  count      Int       @id @default(autoincrement())
  guild_id   BigInt
  user_id    BigInt
  reason     String    @db.Text
  by_user_id BigInt
  is_active  Boolean   @default(true)
  expired_at DateTime? @db.DateTime(0)
  updated_at DateTime  @db.DateTime(0)
  created_at DateTime  @db.DateTime(0)
}

model guilds_punishments_mutes {
  count      Int       @id @default(autoincrement())
  guild_id   BigInt
  user_id    BigInt
  reason     String    @db.Text
  by_user_id BigInt
  is_active  Boolean   @default(true)
  expired_at DateTime? @db.DateTime(0)
  updated_at DateTime  @db.DateTime(0)
  created_at DateTime  @db.DateTime(0)
}

model guilds_punishments_warns {
  count      Int       @id @default(autoincrement())
  guild_id   BigInt
  user_id    BigInt
  reason     String    @db.Text
  by_user_id BigInt
  is_active  Boolean   @default(true)
  expired_at DateTime? @db.DateTime(0)
  updated_at DateTime  @db.DateTime(0)
  created_at DateTime  @db.DateTime(0)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by the Prisma Client.
model partners {
  count       Int
  id          BigInt
  keywords    String   @default("") @db.Text
  description String   @default("") @db.Text
  updated_at  DateTime @db.DateTime(0)
  created_at  DateTime @db.DateTime(0)

  @@ignore
}

model punishments {
  id           Int      @id @default(autoincrement())
  user_id      BigInt
  user_name    String   @db.Text
  reason       String   @default("") @db.Text
  by_user_id   BigInt
  by_user_name String   @db.Text
  guild_id     BigInt
  type         Int      @default(0)
  is_active    Boolean  @default(true)
  updated_at   DateTime @db.DateTime(0)
  created_at   DateTime @db.DateTime(0)
}

model statistics {
  count                     Int      @id @default(autoincrement())
  average_ping              Float
  guilds_count              Int
  channels_count            Int
  channels_categories_count Int
  channels_texts_count      Int
  channels_voices_count     Int
  users_count               Int
  users_members_count       Int
  users_bots_count          Int
  updated_at                DateTime @db.DateTime(0)
  created_at                DateTime @db.DateTime(0)
}

model statistics_system {
  id           Int      @id @default(autoincrement())
  cpu          Float
  memory_total Float
  memory_free  Float
  memory_used  Float
  updated_at   DateTime @db.DateTime(0)
  created_at   DateTime @db.DateTime(0)
}

model system_logs {
  id          Int      @id @default(autoincrement())
  title       String   @db.Text
  description String   @db.Text
  updated_at  DateTime @db.DateTime(0)
  created_at  DateTime @db.DateTime(0)
}

model users {
  id             BigInt   @id
  permission     Int      @default(0)
  evaluate_value Float    @default(10)
  flags          String   @default("{\"verified\":false,\"partner\":false,\"tester\":false,\"bug_hunter\":false}") @db.Text
  prohibit       String   @default("{\"enabled\":false,\"type\":\"CUSTOM\",\"reason\":null,\"expired_at\":null}") @db.Text
  updated_at     DateTime @db.DateTime(0)
  created_at     DateTime @db.DateTime(0)
}

model users_activities {
  id         Int      @id @default(autoincrement())
  user_id    BigInt
  title      String   @db.Text
  channel_id BigInt
  status     Int      @default(1)
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model users_activities_details {
  count      Int      @id @default(autoincrement())
  id         Int
  user_id    BigInt
  message    String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model users_command_logs {
  count      Int      @id @default(autoincrement())
  id         BigInt
  content    String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model users_configurations {
  id            BigInt   @id
  language      String   @default("ja-JP") @db.VarChar(8)
  timezone      String   @default("Asia/Tokyo") @db.VarChar(32)
  accent_color  String   @default("#959ac0") @db.VarChar(16)
  authenticator String   @default("{\"key\":null,\"verification_code\":null,\"scratch_codes\":[]}") @db.Text
  token         String   @default("") @db.Text
  token_secret  String   @default("") @db.Text
  updated_at    DateTime @db.DateTime(0)
  created_at    DateTime @db.DateTime(0)
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by the Prisma Client.
model users_music_histories {
  id         Int
  user_id    BigInt
  title      String   @db.Text
  url        String   @db.Text
  author     String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)

  @@ignore
}

model users_name_change_histories {
  count      Int      @id @default(autoincrement())
  id         BigInt
  name       String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model users_notifications {
  id          Int                      @id @default(autoincrement())
  user_id     BigInt
  name        String                   @db.VarChar(32)
  type        users_notifications_type
  title       String                   @db.VarChar(64)
  description String                   @db.Text
  is_read     Boolean                  @default(false)
  updated_at  DateTime                 @db.DateTime(0)
  created_at  DateTime                 @db.DateTime(0)

  @@unique([user_id, name], map: "UNIQUE")
}

model users_profiles {
  id            BigInt   @id
  name          String   @db.VarChar(32)
  discriminator String   @db.VarChar(4)
  avatar_url    String   @db.Text
  is_bot        Boolean  @default(false)
  updated_at    DateTime @db.DateTime(0)
  created_at    DateTime @db.DateTime(0)
  display_name  String?  @db.VarChar(32)
}

model system_performances {
  id                   Int      @id @default(autoincrement())
  runtime_cpu          Float
  system_cpu           Float
  runtime_memory_total BigInt
  runtime_memory_used  BigInt
  runtime_memory_free  BigInt
  system_memory_total  BigInt
  system_memory_used   BigInt
  system_memory_free   BigInt
  updated_at           DateTime @db.DateTime(0)
  created_at           DateTime @db.DateTime(0)
}

model system_statistics {
  id         Int      @id @default(autoincrement())
  statuses   String   @db.Text
  pings      String   @db.Text
  guilds     String   @db.Text
  channels   String   @db.Text
  roles      String   @db.Text
  emojis     String   @db.Text
  users      String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

view system_statistics_months {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(7)
  statuses   String   @db.Text
  pings      String   @db.Text
  guilds     String   @db.Text
  channels   String   @db.Text
  roles      String   @db.Text
  emojis     String   @db.Text
  users      String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

view system_statistics_days {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(10)
  statuses   String   @db.Text
  pings      String   @db.Text
  guilds     String   @db.Text
  channels   String   @db.Text
  roles      String   @db.Text
  emojis     String   @db.Text
  users      String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

view system_statistics_hours {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(24)
  statuses   String   @db.Text
  pings      String   @db.Text
  guilds     String   @db.Text
  channels   String   @db.Text
  roles      String   @db.Text
  emojis     String   @db.Text
  users      String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

view system_statistics_weeks {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(7)
  statuses   String   @db.Text
  pings      String   @db.Text
  guilds     String   @db.Text
  channels   String   @db.Text
  roles      String   @db.Text
  emojis     String   @db.Text
  users      String   @db.Text
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

enum users_notifications_type {
  success
  warning
  error
  information
}

enum guilds_notifications_type {
  success
  warning
  error
  information
}
