generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model guild_configurations {
  guild_id       BigInt   @id
  prefix         String   @default("s#") @db.VarChar(32)
  nickname       String   @default("[%p] %n") @db.VarChar(32)
  language       String   @default("ja-JP") @db.VarChar(8)
  timezone       String   @default("Asia/Tokyo") @db.VarChar(32)
  commands       Json
  member_join    Json
  goodbye        Json
  activity       Json
  global_chat    Json
  global_ban     Json
  level          Json
  translate      Json
  vote           Json
  quote          Json
  music          Json
  text_to_speech Json
  logging        Json
  updated_at     DateTime @db.DateTime(6)
  created_at     DateTime @db.DateTime(6)
  guilds         guilds   @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_configurations_guild_id__id")
}

model guild_dictionaries {
  guild_id   BigInt
  from       String   @db.VarChar(64)
  to         String   @db.VarChar(64)
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
  guilds     guilds   @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_dictionaries_guild_id__id")

  @@id([guild_id, from])
}

model guild_levels {
  guild_id   BigInt
  user_id    BigInt
  level      BigInt   @default(0)
  experience BigInt   @default(0)
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
  guilds     guilds   @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_levels_guild_id__id")
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_guild_levels_user_id__id")

  @@id([guild_id, user_id])
  @@index([user_id], map: "fk_guild_levels_user_id__id")
}

model guild_notification_reads {
  guild_id            BigInt
  notification_id     String               @db.Char(26)
  user_id             BigInt
  updated_at          DateTime             @db.DateTime(6)
  created_at          DateTime             @db.DateTime(6)
  guilds              guilds               @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_notification_reads_guild_id__id")
  guild_notifications system_notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, map: "fk_guild_notification_reads_notification_id__id")
  users               users                @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_guild_notification_reads_user_id__id")

  @@id([guild_id, notification_id, user_id])
  @@index([notification_id], map: "fk_guild_notification_reads_notification_id__id")
  @@index([user_id], map: "fk_guild_notification_reads_user_id__id")
}

model guild_notifications {
  guild_id             BigInt
  notification_id      String               @db.Char(26)
  updated_at           DateTime             @db.DateTime(6)
  created_at           DateTime             @db.DateTime(6)
  guilds               guilds               @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_notifications_guild_id__id")
  system_notifications system_notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, map: "fk_guild_notifications_notification_id__id")

  @@id([guild_id, notification_id])
  @@index([notification_id], map: "fk_guild_notifications_notification_id__id")
}

model guild_punishment_bans {
  id         Bytes     @id @db.Binary(16)
  guild_id   BigInt
  user_id    BigInt
  by_user_id BigInt
  reason     String    @db.Text
  is_active  Boolean   @default(true)
  expired_at DateTime? @db.DateTime(6)
  updated_at DateTime  @db.DateTime(6)
  created_at DateTime  @db.DateTime(6)
  guilds     guilds    @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_punishment_bans_guild_id__id")

  @@index([guild_id], map: "fk_guild_punishment_bans_guild_id__id")
}

model guild_punishment_mutes {
  id         Bytes     @id @db.Binary(16)
  guild_id   BigInt
  user_id    BigInt
  by_user_id BigInt
  reason     String    @db.Text
  is_active  Boolean   @default(true)
  expired_at DateTime? @db.DateTime(6)
  updated_at DateTime  @db.DateTime(6)
  created_at DateTime  @db.DateTime(6)
  guilds     guilds    @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_punishment_mutes_guild_id__id")

  @@index([guild_id], map: "fk_guild_punishment_mutes_guild_id__id")
}

model guild_punishment_warns {
  id         Bytes     @id @db.Binary(16)
  guild_id   BigInt
  user_id    BigInt
  by_user_id BigInt
  reason     String    @db.Text
  is_active  Boolean   @default(true)
  expired_at DateTime? @db.DateTime(6)
  updated_at DateTime  @db.DateTime(6)
  created_at DateTime  @db.DateTime(6)
  guilds     guilds    @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_punishment_warns_guild_id__id")

  @@index([guild_id], map: "fk_guild_punishment_warns_guild_id__id")
}

model guild_web_categories {
  id                         String                    @id @db.Char(26)
  guild_id                   BigInt
  slug                       String?                   @db.VarChar(64)
  color                      String                    @default("#00000000") @db.VarChar(9)
  name                       String                    @db.VarChar(128)
  description                String                    @default("") @db.VarChar(256)
  parent_id                  String?                   @db.Char(26)
  updated_at                 DateTime                  @db.DateTime(6)
  created_at                 DateTime                  @db.DateTime(6)
  guilds                     guilds                    @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_web_categories_guild_id__id")
  guild_web_categories       guild_web_categories?     @relation("guild_web_categoriesToguild_web_categories", fields: [parent_id], references: [id], onDelete: Cascade, map: "fk_guild_web_categories_parent_id__id")
  other_guild_web_categories guild_web_categories[]    @relation("guild_web_categoriesToguild_web_categories")
  guild_web_page_category    guild_web_page_category[]

  @@unique([guild_id, slug], map: "UNIQUE")
  @@index([parent_id], map: "fk_guild_web_categories_parent_id__id")
}

model guild_web_page_category {
  page_id              String               @id @db.Char(26)
  category_id          String               @db.Char(26)
  updated_at           DateTime             @db.DateTime(6)
  created_at           DateTime             @db.DateTime(6)
  guild_web_categories guild_web_categories @relation(fields: [category_id], references: [id], onDelete: Cascade, map: "fk_guild_web_page_category_category_id__id")
  guild_web_pages      guild_web_pages      @relation(fields: [page_id], references: [id], onDelete: Cascade, map: "fk_guild_web_page_category_page_id__id")

  @@index([category_id], map: "fk_guild_web_page_category_category_id__id")
}

model guild_web_page_contents {
  id                                                                  String            @id @db.Char(26)
  page_id                                                             String            @db.Char(26)
  user_id                                                             BigInt
  icon                                                                String?           @db.VarChar(8)
  title                                                               String            @db.VarChar(128)
  content                                                             String            @db.Text
  is_published                                                        Boolean           @default(false)
  is_auto_save                                                        Boolean           @default(false)
  comment                                                             String            @default("") @db.VarChar(128)
  deleted_at                                                          DateTime?         @db.DateTime(6)
  updated_at                                                          DateTime          @db.DateTime(6)
  created_at                                                          DateTime          @db.DateTime(6)
  guild_web_page                                                      guild_web_pages   @relation("guild_web_page_contents_page_idToguild_web_pages", fields: [page_id], references: [id], onDelete: Cascade, map: "fk_guild_web_page_contents_page_id__id")
  users                                                               users             @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_guild_web_page_contents_user_id__id")
  guild_web_pages_guild_web_pages_content_idToguild_web_page_contents guild_web_pages[] @relation("guild_web_pages_content_idToguild_web_page_contents")

  @@index([page_id], map: "fk_guild_web_page_contents_page_id__id")
  @@index([user_id], map: "fk_guild_web_page_contents_user_id__id")
}

model guild_web_page_tags {
  page_id         String          @db.Char(26)
  tag_id          String          @db.Char(26)
  updated_at      DateTime        @db.DateTime(6)
  created_at      DateTime        @db.DateTime(6)
  guild_web_pages guild_web_pages @relation(fields: [page_id], references: [id], onDelete: Cascade, map: "fk_guild_web_page_tags_page_id__id")
  guild_web_tags  guild_web_tags  @relation(fields: [tag_id], references: [id], onDelete: Cascade, map: "fk_guild_web_page_tags_tag_id__id")

  @@id([page_id, tag_id])
  @@index([tag_id], map: "fk_guild_web_page_tags_tag_id__id")
}

model guild_web_pages {
  id                                                                          String                    @id @db.Char(26)
  content_id                                                                  String?                   @db.Char(26)
  guild_id                                                                    BigInt
  slug                                                                        String?                   @db.VarChar(64)
  deleted_at                                                                  DateTime?                 @db.DateTime(6)
  updated_at                                                                  DateTime                  @db.DateTime(6)
  created_at                                                                  DateTime                  @db.DateTime(6)
  guild_web_page_category                                                     guild_web_page_category?
  guild_web_page_contents                                                     guild_web_page_contents[] @relation("guild_web_page_contents_page_idToguild_web_pages")
  guild_web_page_tags                                                         guild_web_page_tags[]
  guild_web_page_contents_guild_web_pages_content_idToguild_web_page_contents guild_web_page_contents?  @relation("guild_web_pages_content_idToguild_web_page_contents", fields: [content_id], references: [id], map: "fk_guild_web_pages_content_id__id")
  guilds                                                                      guilds                    @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_web_pages_guild_id__id")

  @@unique([guild_id, slug], map: "UNIQUE")
  @@index([content_id], map: "fk_guild_web_pages_content_id__id")
}

model guild_web_tags {
  id                  String                @id @db.Char(26)
  guild_id            BigInt
  slug                String?               @db.VarChar(64)
  color               String                @default("#00000000") @db.VarChar(9)
  name                String                @db.VarChar(64)
  description         String                @default("") @db.VarChar(128)
  updated_at          DateTime              @db.DateTime(6)
  created_at          DateTime              @db.DateTime(6)
  guild_web_page_tags guild_web_page_tags[]
  guilds              guilds                @relation(fields: [guild_id], references: [id], onDelete: Cascade, map: "fk_guild_web_tags_guild_id__id")

  @@unique([guild_id, slug], map: "UNIQUE")
}

model guilds {
  id                       BigInt                     @id
  flags                    Json                       @default(dbgenerated("(_utf8mb4\\'{\"verified\":false,\"partner\":false,\"tester\":false}\\')"))
  prohibit                 Json                       @default(dbgenerated("(_utf8mb4\\'{\"enabled\":false,\"type\":\"CUSTOM\",\"reason\":null,\"expired_at\":null}\\')"))
  updated_at               DateTime                   @db.DateTime(6)
  created_at               DateTime                   @db.DateTime(6)
  guild_configurations     guild_configurations?
  guild_dictionaries       guild_dictionaries[]
  guild_levels             guild_levels[]
  guild_notification_reads guild_notification_reads[]
  guild_notifications      guild_notifications[]
  guild_punishment_bans    guild_punishment_bans[]
  guild_punishment_mutes   guild_punishment_mutes[]
  guild_punishment_warns   guild_punishment_warns[]
  guild_web_categories     guild_web_categories[]
  guild_web_pages          guild_web_pages[]
  guild_web_tags           guild_web_tags[]
}

model system_logs {
  id          Int      @id @default(autoincrement())
  title       String   @db.Text
  description String   @db.Text
  updated_at  DateTime @db.DateTime(6)
  created_at  DateTime @db.DateTime(6)
}

model system_notifications {
  id                       String                     @id @db.Char(26)
  type                     system_notifications_type
  title                    String                     @db.VarChar(64)
  description              String                     @db.Text
  updated_at               DateTime                   @db.DateTime(6)
  created_at               DateTime                   @db.DateTime(6)
  guild_notification_reads guild_notification_reads[]
  guild_notifications      guild_notifications[]
  user_notifications       user_notifications[]
}

model system_performances {
  id                   Int      @id @default(autoincrement())
  runtime_cpu          Float
  system_cpu           Float
  runtime_memory_total BigInt
  runtime_memory_used  BigInt
  runtime_memory_free  BigInt
  system_memory_total  BigInt
  system_memory_used   BigInt
  system_memory_free   BigInt
  updated_at           DateTime @db.DateTime(6)
  created_at           DateTime @unique(map: "UNIQUE") @db.DateTime(6)
}

model system_statistics {
  id         Int      @id @default(autoincrement())
  statuses   Json
  pings      Json
  guilds     Json
  channels   Json
  roles      Json
  emojis     Json
  users      Json
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @unique(map: "UNIQUE") @db.DateTime(6)
}

model user_command_logs {
  count      Int      @id @default(autoincrement())
  id         BigInt
  content    String   @db.Text
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
}

model user_configurations {
  user_id       BigInt   @id
  language      String   @default("ja-JP") @db.VarChar(8)
  timezone      String   @default("Asia/Tokyo") @db.VarChar(32)
  accent_color  String   @default("#959ac0") @db.VarChar(9)
  translate     Json
  authenticator Json
  token         String   @db.Text
  token_secret  String   @db.Text
  updated_at    DateTime @db.DateTime(6)
  created_at    DateTime @db.DateTime(6)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user_configurations_user_id__id")
}

model user_notifications {
  user_id              BigInt
  notification_id      String               @db.Char(26)
  is_read              Boolean              @default(false)
  updated_at           DateTime             @db.DateTime(6)
  created_at           DateTime             @db.DateTime(6)
  system_notifications system_notifications @relation(fields: [notification_id], references: [id], onDelete: Cascade, map: "fk_user_notifications_notification_id__id")
  users                users                @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user_notifications_user_id__id")

  @@id([user_id, notification_id])
  @@index([notification_id], map: "fk_user_notifications_notification_id__id")
}

model users {
  id                       BigInt                     @id
  permission               Int                        @default(0)
  evaluate_value           Float                      @default(10)
  flags                    Json
  prohibit                 Json
  updated_at               DateTime                   @db.DateTime(6)
  created_at               DateTime                   @db.DateTime(6)
  guild_levels             guild_levels[]
  guild_notification_reads guild_notification_reads[]
  guild_web_page_contents  guild_web_page_contents[]
  user_configurations      user_configurations?
  user_notifications       user_notifications[]
}

view system_statistics_months {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(7)
  statuses   Json
  pings      Json
  guilds     Json
  channels   Json
  roles      Json
  emojis     Json
  users      Json
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
}

view system_statistics_days {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(10)
  statuses   Json
  pings      Json
  guilds     Json
  channels   Json
  roles      Json
  emojis     Json
  users      Json
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
}

view system_statistics_hours {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(24)
  statuses   Json
  pings      Json
  guilds     Json
  channels   Json
  roles      Json
  emojis     Json
  users      Json
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
}

view guild_levels_with_rank {
  guild_id   BigInt
  user_id    BigInt
  rank       BigInt   @default(0) @db.UnsignedBigInt
  level      BigInt   @default(0)
  experience BigInt   @default(0)
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)

  @@id([guild_id, user_id])
}

view system_statistics_weeks {
  id         Int      @unique @default(0)
  group_by   String?  @db.VarChar(7)
  statuses   Json
  pings      Json
  guilds     Json
  channels   Json
  roles      Json
  emojis     Json
  users      Json
  updated_at DateTime @db.DateTime(6)
  created_at DateTime @db.DateTime(6)
}

enum system_notifications_type {
  success
  warning
  error
  information
}
