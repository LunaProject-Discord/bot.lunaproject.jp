  @@ignore
}

model users_name_change_histories {
  count      Int      @id @default(autoincrement())
  id         BigInt
  name       String   @db.LongText
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

model users_notifications {
  id          Int                      @id @default(autoincrement())
  user_id     BigInt
  name        String                   @db.VarChar(32)
  type        users_notifications_type
  title       String                   @db.VarChar(64)
  description String                   @db.LongText
  is_read     Boolean                  @default(false)
  updated_at  DateTime                 @db.DateTime(0)
  created_at  DateTime                 @db.DateTime(0)

  @@unique([user_id, name], map: "UNIQUE")
}

model users_profiles {
  id            BigInt   @id
  name          String   @db.VarChar(100)
  discriminator String   @db.VarChar(4)
  avatar_url    String   @db.LongText
  is_bot        Boolean  @default(false)
  updated_at    DateTime @db.DateTime(0)
  created_at    DateTime @db.DateTime(0)
}

model users_settings {
  id            BigInt   @id
  language      String   @default("ja-JP") @db.VarChar(10)
  timezone      String   @default("Asia/Tokyo") @db.VarChar(50)
  accent_color  String   @default("#959ac0") @db.VarChar(30)
  authenticator String   @default("{\"key\":null,\"verification_code\":null,\"scratch_codes\":[]}") @db.LongText
  token         String   @default("") @db.LongText
  token_secret  String   @default("") @db.LongText
  updated_at    DateTime @db.DateTime(0)
  created_at    DateTime @db.DateTime(0)
}

enum users_notifications_type {
  success
  warning
  error
  information
}

enum guilds_notifications_type {
  success
  warning
  error
  information
}
