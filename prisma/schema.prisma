}

model punishments {
  id           Int      @id @default(autoincrement())
  user_id      BigInt
  user_name    String   @db.LongText
  reason       String   @default("") @db.LongText
  by_user_id   BigInt
  by_user_name String   @db.LongText
  guild_id     BigInt
  type         Int      @default(0)
  is_active    Boolean  @default(true)
  updated_at   DateTime @db.DateTime(0)
  created_at   DateTime @db.DateTime(0)
}

model statistics {
  count                     Int      @id @default(autoincrement())
  average_ping              Float
  guilds_count              Int
  channels_count            Int
  channels_categories_count Int
  channels_texts_count      Int
  channels_voices_count     Int
  users_count               Int
  users_members_count       Int
  users_bots_count          Int
  updated_at                DateTime @db.DateTime(0)
  created_at                DateTime @db.DateTime(0)
}

model statistics_system {
  id           Int      @id @default(autoincrement())
  cpu          Float
  memory_total Float
  memory_free  Float
  memory_used  Float
  updated_at   DateTime @db.DateTime(0)
  created_at   DateTime @db.DateTime(0)
}

model system_logs {
  id          Int      @id @default(autoincrement())
  title       String   @db.LongText
  description String   @db.LongText
  updated_at  DateTime @db.DateTime(0)
  created_at  DateTime @db.DateTime(0)
}

model users {
  id             BigInt   @id
  permission     Int      @default(0)
  evaluate_value Float    @default(10)
  flags          String   @default("{\"verified\":false,\"partner\":false,\"tester\":false,\"bug_hunter\":false}") @db.LongText
  prohibit       String   @default("{\"enabled\":false,\"type\":\"CUSTOM\",\"reason\":null,\"expired_at\":null}") @db.LongText
  updated_at     DateTime @db.DateTime(0)
  created_at     DateTime @db.DateTime(0)
}

model users_command_logs {
  count      Int      @id @default(autoincrement())
  id         BigInt
  content    String   @db.LongText
  updated_at DateTime @db.DateTime(0)
  created_at DateTime @db.DateTime(0)
}

